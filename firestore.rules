rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'github.com'
        && 'github.com' in request.auth.token.firebase.identities
        && request.auth.token.firebase.identities['github.com'].hasAny(['332598033']);
    }
    function noteShape() {
      return request.resource.data.keys().hasOnly(['text','revision','updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/{document=**} { allow read: if owner(uid); }
    match /users/{uid}/notes/main {
      allow create: if owner(uid) && noteShape() && request.resource.data.revision == 1;
      allow update: if owner(uid) && noteShape() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{uid}/noteHistory/{version} {
      allow create: if owner(uid) && noteShape()
        && getAfter(/databases/$(database)/documents/users/$(uid)/notes/main).data == request.resource.data;
    }
    match /users/{uid}/progress/{lesson} {
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['completed','updatedAt'])
        && request.resource.data.completed is bool && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/attempts/{attempt} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['lessonId','exerciseId','answer','createdAt'])
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 200
        && request.resource.data.exerciseId is string && request.resource.data.exerciseId.size() <= 200
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 20000
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/bookmarks/{lesson} {
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['saved','updatedAt'])
        && request.resource.data.saved is bool && request.resource.data.updatedAt == request.time;
    }
    function plannerShape() {
      return request.resource.data.keys().hasOnly(['payload','revision','updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 100000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/planner/main {
      allow create: if owner(uid) && plannerShape() && request.resource.data.revision == 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/plannerHistory/1).data == request.resource.data;
      allow update: if owner(uid) && plannerShape() && request.resource.data.revision == resource.data.revision + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/plannerHistory/$(string(request.resource.data.revision))).data == request.resource.data;
    }
    match /users/{uid}/plannerHistory/{version} {
      allow create: if owner(uid) && plannerShape()
        && version == string(request.resource.data.revision)
        && getAfter(/databases/$(database)/documents/users/$(uid)/planner/main).data == request.resource.data;
    }
    // Planner payload is owner-authored scheduling data, never assessed attainment.
    // Assessments, backup metadata, and all other writes are server-managed.
  }
}
