rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'github.com'
        && 'github.com' in request.auth.token.firebase.identities
        && request.auth.token.firebase.identities['github.com'].hasAny(['332598033']);
    }
    function noteShape() {
      return request.resource.data.keys().hasOnly(['text','revision','updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/{document=**} { allow read: if owner(uid); }
    match /users/{uid}/notes/main {
      allow create: if owner(uid) && noteShape() && request.resource.data.revision == 1;
      allow update: if owner(uid) && noteShape() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{uid}/noteHistory/{version} {
      allow create: if owner(uid) && noteShape()
        && getAfter(/databases/$(database)/documents/users/$(uid)/notes/main).data == request.resource.data;
    }
    match /users/{uid}/progress/{lesson} {
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['completed','updatedAt'])
        && request.resource.data.completed is bool && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/attempts/{attempt} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['lessonId','exerciseId','answer','createdAt'])
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() <= 200
        && request.resource.data.exerciseId is string && request.resource.data.exerciseId.size() <= 200
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 20000
        && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/bookmarks/{lesson} {
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['saved','updatedAt'])
        && request.resource.data.saved is bool && request.resource.data.updatedAt == request.time;
    }
    function plannerShape() {
      return request.resource.data.keys().hasOnly(['payload','revision','updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 100000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/planner/main {
      allow create: if owner(uid) && plannerShape() && request.resource.data.revision == 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/plannerHistory/1).data == request.resource.data;
      allow update: if owner(uid) && plannerShape() && request.resource.data.revision == resource.data.revision + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/plannerHistory/$(string(request.resource.data.revision))).data == request.resource.data;
    }
    match /users/{uid}/plannerHistory/{version} {
      allow create: if owner(uid) && plannerShape()
        && version == string(request.resource.data.revision)
        && getAfter(/databases/$(database)/documents/users/$(uid)/planner/main).data == request.resource.data;
    }
    function profileShape() {
      return request.resource.data.keys().hasOnly(['payload','revision','updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 250000
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/profile/main {
      allow create: if owner(uid) && profileShape() && request.resource.data.revision == 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/profileHistory/1).data == request.resource.data;
      allow update: if owner(uid) && profileShape() && request.resource.data.revision == resource.data.revision + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/profileHistory/$(string(request.resource.data.revision))).data == request.resource.data;
    }
    match /users/{uid}/profileHistory/{version} {
      allow create: if owner(uid) && profileShape() && version == string(request.resource.data.revision)
        && getAfter(/databases/$(database)/documents/users/$(uid)/profile/main).data == request.resource.data;
    }
    match /users/{uid}/journal/{entry} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion','category','title','body','area','evidence','nextSteps','source','occurredAt','corrects','recordedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.category in ['knowledge','skills','difficulties','feedback','assessment','milestone','reflection','conversation','activity']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 20000
        && request.resource.data.area is string && request.resource.data.area.size() <= 300
        && request.resource.data.evidence is string && request.resource.data.evidence.size() <= 2000
        && request.resource.data.nextSteps is string && request.resource.data.nextSteps.size() <= 2000
        && request.resource.data.source is string && request.resource.data.source.size() <= 200
        && request.resource.data.occurredAt is string && request.resource.data.occurredAt.size() <= 30
        && request.resource.data.corrects is string && request.resource.data.corrects.size() <= 200
        && request.resource.data.recordedAt == request.time;
      // Append only: corrections refer to the earlier entry; no rewriting history.
    }
    // Personal evidence is immutable recovery data, not assessed attainment.
    match /users/{uid}/evidence/{snapshot} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['root','previousRoot','sequence','parts','payloadHash','createdAt','recordedAt'])
        && request.resource.data.root == '0x' + snapshot
        && snapshot.matches('[a-f0-9]{64}')
        && request.resource.data.previousRoot is string
        && request.resource.data.previousRoot.size() <= 66
        && request.resource.data.payloadHash.matches('0x[a-f0-9]{64}')
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 30
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 80
        && request.resource.data.sequence is int && request.resource.data.sequence >= 1
        && request.resource.data.recordedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)/evidenceState/main).data.root == request.resource.data.root
        && getAfter(/databases/$(database)/documents/users/$(uid)/evidenceState/main).data.sequence == request.resource.data.sequence;
      match /parts/{part} {
        allow create: if owner(uid) && part.matches('[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['payload'])
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 400000
          && getAfter(/databases/$(database)/documents/users/$(uid)/evidence/$(snapshot)).data.recordedAt == request.time;
      }
      match /anchors/{transaction} {
        allow create: if owner(uid) && transaction.matches('[a-f0-9]{64}')
          && exists(/databases/$(database)/documents/users/$(uid)/evidence/$(snapshot))
          && request.resource.data.keys().hasOnly(['payload','recordedAt'])
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 10000
          && request.resource.data.recordedAt == request.time;
        // Receipt fields are untrusted until independently checked against Ethereum.
      }
    }
    function evidenceHeadShape(uid) {
      return request.resource.data.keys().hasOnly(['root','sequence','updatedAt'])
        && request.resource.data.root.matches('0x[a-f0-9]{64}')
        && request.resource.data.sequence is int && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)/evidence/$(request.resource.data.root.replace('0x',''))).data.sequence == request.resource.data.sequence
        && getAfter(/databases/$(database)/documents/users/$(uid)/evidence/$(request.resource.data.root.replace('0x',''))).data.recordedAt == request.time;
    }
    match /users/{uid}/evidenceState/main {
      allow create: if owner(uid) && evidenceHeadShape(uid) && request.resource.data.sequence == 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/evidence/$(request.resource.data.root.replace('0x',''))).data.previousRoot == '';
      allow update: if owner(uid) && evidenceHeadShape(uid) && request.resource.data.sequence == resource.data.sequence + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/evidence/$(request.resource.data.root.replace('0x',''))).data.previousRoot == resource.data.root;
    }
    // Planner payload is owner-authored scheduling data, never assessed attainment.
    // Assessments, backup metadata, and all other writes are server-managed.
  }
}
